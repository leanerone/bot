<Window x:Class="FabBot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Fab Bot" Width="1200" Height="800" MinWidth="900" MinHeight="620"
        Icon="pack://application:,,,/Assets/fabbot.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#EEF2FB" AllowDrop="False">
    <!-- 无边框窗口仍需要可拖拽缩放的边缘 -->
    <shell:WindowChrome.WindowChrome>
        <!-- 原生缩放边框被 WebView2 的 HWND 挡住，改由网页热区实现；此处设为 0 -->
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <!-- WebView2 是独立 HWND (airspace)，会盖住所有 WPF 元素。
             窗口按钮 / 拖拽区改由网页标题栏实现，通过 WebMessage 与此处通信。 -->
        <wv2:WebView2 x:Name="Web" Visibility="Hidden" />

        <!-- 启动遮罩：仅在 WebView 隐藏期间可见，承载启动/错误状态 -->
        <Grid x:Name="LoadingMask">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#EEF2FB" Offset="0" />
                    <GradientStop Color="#F7F2FA" Offset="0.52" />
                    <GradientStop Color="#EAF6F4" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/fabbot.png" Width="76" Height="76"
                       HorizontalAlignment="Center" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Fab Bot" FontSize="24" FontWeight="Bold" Foreground="#1C1B1F"
                           HorizontalAlignment="Center" />
                <TextBlock Text="半导体工厂 AI 助手 · Desktop" FontSize="12" Foreground="#8E8E93"
                           HorizontalAlignment="Center" Margin="0,6,0,22" />
                <TextBlock x:Name="StateText" Text="正在启动后端服务…" FontSize="12.5"
                           Foreground="#6E6E73" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
